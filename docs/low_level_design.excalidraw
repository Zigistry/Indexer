      "updated": 1795527261457,
      "created": 1795354614206,
      "link": null,
      "locked": false,
      "text": "If the threat detection algorithm marks a repository for\nmanual review, a manual review is done, and if it is really\nfound out that a repo owner was trying to trick viewers\ninto installing an unknown binary, only then, the repo\nowner is added to banned_users.",
      "fontSize": 9.414521179394365,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "27gTG9dRK7j0OGskt6nq4",
