    {
      "id": "eqfdHW8ZGcG02I2JB-r2W",
      "type": "text",
      "x": -7820.829906621321,
      "y": -11230.053470063815,
      "width": 989.7983355990118,
      "height": 83.14499177651622,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
