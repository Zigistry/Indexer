      "locked": false,
      "text": "Step 1 (Generate Time Ranges For Crawler):",
      "fontSize": 42.05143853482131,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 1 (Generate Time Ranges For Crawler):",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "w4LocTEoTuykjb24UISYb",
      "type": "text",
      "x": -11247.846147327706,
      "y": -8075.556231811752,
      "width": 297.3886844213102,
      "height": 191.82076389854444,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bVp",
      "roundness": null,
      "seed": 246554678,
      "version": 604,
      "versionNonce": 1765487830,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795478222033,
      "created": 1795310445296,
      "link": null,
      "locked": false,
      "text": "Each thread will has its own keep alive\nconnection.\nIf I have 8 threads there will be a\nunique client for each thread that will\nmaintain a keep alive with the GitHub's\nserver. This has been done using\n`thread_local` keyword. I achieved\nrange splitting ~1 Million repos (topic\nas python) within 2 minutes 37\nseconds.",
      "fontSize": 15.345661111883556,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each thread will has its own keep alive connection.\nIf I have 8 threads there will be a unique client for each thread that will maintain a keep alive with the GitHub's server. This has been done using `thread_local` keyword. I achieved range splitting ~1 Million repos (topic as python) within 2 minutes 37 seconds.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
