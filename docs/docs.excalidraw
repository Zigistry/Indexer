      "link": null,
      "locked": false,
      "text": "A query with a nameWithOwner and OID becomes\nvery slow for indexing. Because an OID requires\nnesting the query leading to responses taking\ntime to respond and results in too many 5xx errors.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A query with a nameWithOwner and OID becomes\nvery slow for indexing. Because an OID requires\nnesting the query leading to responses taking\ntime to respond and results in too many 5xx errors.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
