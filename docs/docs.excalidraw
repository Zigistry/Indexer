      "link": null,
      "locked": false,
      "text": "within 1000 repo limit\nrange no more splitting\nneeded",
      "fontSize": 7.531616943515492,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "within 1000 repo limit range no more splitting needed",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "EHgSO7099CqR6vBFkmrTX",
      "type": "text",
      "x": -24923.2877964646,
      "y": -11036.192393818452,
      "width": 117.96760925010202,
      "height": 84.73069061454927,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 270513848,
      "version": 2027,
      "versionNonce": 1677052282,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795072519894,
      "created": 1794425900473,
      "link": null,
      "locked": false,
      "text": "too much more than 1000\nrepo limit range, requires more\nsplitting but the splitting itself\nwill take too much time\nif repositories with that topic\nare > 1 Million.\nright now, repositories are less\nthan 10,000 for zig, I am trying\nto make this future proof.",
      "fontSize": 7.531616943515491,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "too much more than 1000\nrepo limit range, requires more\nsplitting but the splitting itself\nwill take too much time\nif repositories with that topic\nare > 1 Million.\nright now, repositories are less\nthan 10,000 for zig, I am trying\nto make this future proof.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
