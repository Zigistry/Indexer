    {
      "id": "EHgSO7099CqR6vBFkmrTX",
      "type": "text",
      "x": -16818.52651387539,
      "y": -8554.270151717534,
      "width": 250.60777282714844,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 1076181053,
      "version": 1128,
      "versionNonce": 58464309,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794744455367,
      "created": 1794425900473,
      "link": null,
      "locked": false,
      "text": "too much more than 1000\nrepo limit range, requires more\nsplitting but the splitting itself\nwill take too much time\nif repositories with that topic\nare > 1 Million.\nright now, repositories are less\nthan 10,000 for zig, I am trying\nto make this future proof.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "too much more than 1000\nrepo limit range, requires more\nsplitting but the splitting itself\nwill take too much time\nif repositories with that topic\nare > 1 Million.\nright now, repositories are less\nthan 10,000 for zig, I am trying\nto make this future proof.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
