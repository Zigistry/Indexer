    {
      "id": "AjTs0FhcYqo3-uuexYcYp",
      "type": "text",
      "x": -25287.35395125726,
      "y": -9092.26690505378,
      "width": 567.0394101888743,
      "height": 98.85247238364083,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bC8",
      "roundness": null,
      "seed": 201744824,
      "version": 2614,
      "versionNonce": 1490407034,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795072519895,
      "created": 1794855698022,
      "link": null,
      "locked": false,
      "text": "I just realised that, the biggest problem I had done since Zigistry beta, was that I\nthought indexing new repositories and updating existing once has to be done together,\nwhich caused massive code bases and a lot of very difficult to find bugs. Hence,\nI'll be seperating indexing and updating, I though that, to update repositories, i'll use\npushedAt and updatedAt parameter, but that would cause extreme code complexity in\nthe upcomming architecture.",
      "fontSize": 13.180329651152109,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I just realised that, the biggest problem I had done since Zigistry beta, was that I thought indexing new repositories and updating existing once has to be done together, which caused massive code bases and a lot of very difficult to find bugs. Hence,\nI'll be seperating indexing and updating, I though that, to update repositories, i'll use pushedAt and updatedAt parameter, but that would cause extreme code complexity in the upcomming architecture.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "oZoeAP1egCvCcCaMizf9c",
      "type": "arrow",
      "x": -24996.65287298049,
      "y": -9163.100518940086,
      "width": 0.25235176732894615,
      "height": 57.540618756453114,
      "angle": 0,
