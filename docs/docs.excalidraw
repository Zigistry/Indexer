      "text": "Number of threads: 8",
      "fontSize": 11.378544104473766,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Number of threads: 8",
