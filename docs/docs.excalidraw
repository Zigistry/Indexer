    {
      "id": "TNEPqmjdbaR1YY4E0cVkQ",
      "type": "text",
      "x": -18394.66911013266,
      "y": -11080.396593017449,
      "width": 1666.6279474333942,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOP",
      "roundness": null,
      "seed": 358994148,
      "version": 1012,
      "versionNonce": 1459704164,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795120307910,
      "created": 1795119576718,
      "link": null,
      "locked": false,
      "text": "I compile the backend binary file using GitHub actions workflow. Backend doesn't reqire any frequent code changes unless\nthe entire database architecture itself is chaneging, hence I use basic GCP console to manually update the backend\nbinary once an entire update is ready to be shipped. Automating this process might cause more harm then benifit.\nBecause the binary sometimes doesn't work or docker fails, then I eventually have to manually do stuff.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I compile the backend binary file using GitHub actions workflow. Backend doesn't reqire any frequent code changes unless the entire database architecture itself is chaneging, hence I use basic GCP console to manually update the backend binary once an entire update is ready to be shipped. Automating this process might cause more harm then benifit. Because the binary sometimes doesn't work or docker fails, then I eventually have to manually do stuff.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
