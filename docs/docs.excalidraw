    {
      "id": "svpFX4XiQtfvdJd-0CEds",
      "type": "text",
      "x": -17342.74896826957,
      "y": -9526.178973717408,
      "width": 746.8594360351562,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 1722294459,
      "version": 639,
      "versionNonce": 963185979,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794578528106,
      "created": 1794575163318,
      "link": null,
      "locked": false,
      "text": "I had initially used a for loop with a fixed 1 month interval, it didn't work.\nBecause, from 2008 till ~2010 the indexing was like 0 repos per month.\nWhich would generate multiple empty ranges. And when 1 month contained like\n>10,000 repos, the splitting was more difficult.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I had initially used a for loop with a fixed 1 month interval, it didn't work.\nBecause, from 2008 till ~2010 the indexing was like 0 repos per month.\nWhich would generate multiple empty ranges. And when 1 month contained like\n>10,000 repos, the splitting was more difficult.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
