    {
      "id": "ArOItVmOHvrv3y38htVDI",
      "type": "text",
      "x": -11803.407931933381,
      "y": -10682.69455402684,
      "width": 258.2067914836411,
      "height": 149.89299836443794,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bXD",
      "roundness": null,
      "seed": 1842753078,
      "version": 781,
      "versionNonce": 133491754,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795312560828,
      "created": 1795311854787,
      "link": null,
      "locked": false,
      "text": "Again, Each thread will has its own\nkeep alive connection.\nIf I have 8 threads there will be a\nunique client for each thread that will\nmaintain a keep alive with the GitHub's\nserver. This has been done using\n`thread_local` keyword. I achieved\ncrawling ~1 Million repos (topic as\npython) within 1 hour 17 minutes.",
      "fontSize": 13.32382207683893,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Again, Each thread will has its own keep alive connection.\nIf I have 8 threads there will be a unique client for each thread that will maintain a keep alive with the GitHub's server. This has been done using `thread_local` keyword. I achieved crawling ~1 Million repos (topic as python) within 1 hour 17 minutes.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
